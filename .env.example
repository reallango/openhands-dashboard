# Copy to .env (or paste into the stack's environment in Bosun) and fill in. Never commit the real .env.

# OpenHands Cloud API key (https://app.all-hands.dev > Settings > API keys). Stays on the server.
OPENHANDS_API_KEY=

# Web login. Create the hash with:  node scripts/hash-password.js
#   or, without Node:  docker run --rm -it openhands-dashboard:local node scripts/hash-password.js
# The hash has no "$" characters, so it can be pasted as is.
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=

# Bearer token for Claude's API calls (at least 24 characters). Create one with:
#   node scripts/hash-password.js --token     (or: openssl rand -base64 32)
API_TOKEN=

# Port on the Docker host.
HOST_PORT=3077

# Set to true only when the dashboard is served over HTTPS (for example behind a reverse proxy).
COOKIE_SECURE=false

# Defaults for the "New task" form and POST /api/start.
DEFAULT_REPO=
DEFAULT_BRANCH=main

# Optional tuning (seconds / minutes / hours):
# ACTIVE_POLL_SEC=20        how often running conversations are polled
# LIST_POLL_SEC=60          how often the conversation list is checked while something runs
# IDLE_LIST_POLL_SEC=300    ... and while nothing runs
# STALLED_MINUTES=20        a running conversation with no activity for this long is marked "stalled"
# RECENT_HOURS=24           how far back /api/summary looks for finished tasks
# SESSION_DAYS=14           how long a web login lasts
